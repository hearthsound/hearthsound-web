{
  "name": "hearthsound-web",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "First-party web client for Hearthsound",
  "license": "AGPL-3.0-or-later",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "predev": "node scripts/showcase-route.mjs on",
    "dev": "vite dev",
    "prebuild": "node scripts/showcase-route.mjs off",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:check": "node scripts/sync-openapi.mjs --check",
    "package": "node scripts/package.mjs"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@hearthsound/design": "0.2.11",
    "@jsonforms/core": "3.8.0",
    "openapi-fetch": "0.17.0",
    "svelte-dnd-action": "0.9.80"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
